        given-names: Katherine M.
      - family-names: Koper
        given-names: Keith D.
      - family-names: Pankow
        given-names: Kristine L.
      - family-names: Mayeda
        given-names: Kevin
      - family-names: Pechmann
        given-names: James C.
      - family-names: Edwards
        given-names: Benjamin
      - family-names: Gök
        given-names: Rengin
      - family-names: Walter
        given-names: William R.
    journal: "Seismological Research Letters"

  - type: article
    title: "Automatic computation of moment magnitudes for small earthquakes and
      the scaling of local to moment magnitude"
    authors:
      - family-names: Edwards
        given-names: Benjamin
