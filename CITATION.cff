cff-version: 1.2.0
message: "If you use this software, please cite both the software and the paper below."
title: "SpecMod: a Python toolbox for processing and modelling seismic spectra"
type: software
authors:
  - family-names: Holt
    given-names: James
repository-code: "https://github.com/sgjholt/SpecMod"
license: MIT
identifiers:
  # The concept DOI, which always resolves to the newest release. Zenodo also
  # mints a version DOI per release; cite that one instead when reproducibility
  # matters and you need the reader to land on the exact version you ran.
  - type: doi
    value: "10.5281/zenodo.22071454"
    description: "Concept DOI — resolves to the latest release."
keywords:
  - seismology
  - spectral modelling
  - moment magnitude
  - source parameters

references:
  - type: article
    title: "Towards Robust and Routine Determination of Mw for Small Earthquakes:
      Application to the 2020 Mw 5.7 Magna, Utah, Seismic Sequence"
    authors:
      - family-names: Holt
        given-names: James
